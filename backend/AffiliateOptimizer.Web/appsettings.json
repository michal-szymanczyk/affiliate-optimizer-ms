{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "App": "Server=(localdb)\\MSSQLLocalDB;Database=AffiliateOptimizer;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "AffiliateService": {
    "ServerUrl": "",
    "AppKey": "",
    "AppSecret": "",
    "TimeoutSeconds": 10
  },
  "Operator": {
    "Email": "operator@local",
    "Password": ""
  },
  "Loop": {
    "ResumeActiveRunOnStartup": true,
    "AutoStartModel": null
  },
  "Models": {
    "epsilon-greedy": { "Epsilon": 0.10, "MinSamples": 3 },
    "sliding-window-ucb": { "C": 0.05 }
  },
  "Evaluation": {
    "RecentWindowMinutes": 10,
    "StaleAfterMinutes": 5,
    "ThinBelow": 10,
    "MinSamplesPerArm": 30
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Spa": {
    "RootPath": "wwwroot"
  },
  "HideExceptionDetailsFromClient": false
}
