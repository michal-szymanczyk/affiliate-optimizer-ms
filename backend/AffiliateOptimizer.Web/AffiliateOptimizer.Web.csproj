<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ASP.NET Core host: composition root, controllers, Identity login, hosted loops, SPA hosting (ArchitectureSimple.md §3.3). -->
  <PropertyGroup>
    <UserSecretsId>affiliate-optimizer-web</UserSecretsId>
    <!-- The React operator UI lives in ../../frontend; its production build is served from wwwroot after publish. -->
    <SpaRoot>..\..\frontend\</SpaRoot>
    <SpaDist>$(SpaRoot)dist\</SpaDist>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AffiliateOptimizer.Domain\AffiliateOptimizer.Domain.csproj" />
    <ProjectReference Include="..\AffiliateOptimizer.Repository\AffiliateOptimizer.Repository.csproj" />
    <!-- OpenTelemetry and /health, /alive for the Aspire dashboard (registered from Program.cs, not Startup). -->
    <ProjectReference Include="..\AffiliateOptimizer.ServiceDefaults\AffiliateOptimizer.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Publish builds the SPA and ships its dist/ as wwwroot/ (ArchitectureSimple.md §11).
    Skip with -p:SkipSpaBuild=true when publishing the API alone.
  -->
  <Target Name="PublishSpa" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipSpaBuild)' != 'true'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
    <ItemGroup>
      <SpaDistFiles Include="$(SpaDist)**" />
      <ResolvedFileToPublish Include="@(SpaDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
